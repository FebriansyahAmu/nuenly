{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Pengaturan: membaca dan mengubah setelan (model, pintasan), mode, dan jeda; memeriksa Ollama dan membuka halaman unduhannya; melihat dan menghapus riwayat aktivitas.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-audit-clear",
    "allow-audit-list",
    "allow-settings-get",
    "allow-settings-set-hotkey",
    "allow-settings-set-model",
    "allow-status-get",
    "allow-status-set-mode",
    "allow-status-pause",
    "allow-status-resume",
    "allow-ollama-status",
    "allow-ollama-open-download"
  ]
}
